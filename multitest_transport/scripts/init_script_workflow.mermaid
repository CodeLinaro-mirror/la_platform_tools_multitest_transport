%% LINT.IfChange
flowchart TD
    Start(["Start init.sh"]) --> Env["Load Environment & Local Variables"]
    Env --> ModeDet{"Determine Mode<br/>(MTT_CONTROL_SERVER_URL<br/>& OPERATION_MODE)"}

    ModeDet -->|Worker Mode| SetWorker["ENABLE_CONTROLLER_FEATURES = false<br/>Configure Remote Targets<br/>Set RUNNING_MODE = worker"]
    ModeDet -->|Controller Mode| SetCtrl["ENABLE_WORKER_FEATURES = false<br/>Set RUNNING_MODE = controller"]
    ModeDet -->|Standalone / Default| SetBoth["Both Features Enabled<br/>Set RUNNING_MODE = standalone"]

    SetWorker --> Certs["Import CA Certificates &<br/>Configure Proxy Settings"]
    SetCtrl --> Certs
    SetBoth --> Certs

    Certs --> Mounts["Link Temporary Mounts<br/>to Local File Store"]
    Mounts --> PreRun{"Check Pre-run Scripts"}

    PreRun -->|Exists| RunPreRun["Source init_pre_run.sh<br/>& mysql.sh"]
    PreRun -->|None| CheckCtrl{"ENABLE_CONTROLLER_FEATURES<br/>== true?"}
    RunPreRun --> CheckCtrl

    CheckCtrl -->|Yes| StartRabbit["Start RabbitMQ Server"]
    StartRabbit --> CheckOmniCtrl{"IS_OMNILAB_BASED?"}
    CheckOmniCtrl -->|Yes| StartMySQL["Start MySQL Database"]
    StartMySQL --> CheckCfg{"Config Service<br/>Enabled?"}
    CheckCfg -->|Yes| StartCfg["Start Config Service<br/>(device_config_server_deploy.jar)"]
    CheckCfg -->|No| StartOLC["Start OLC Server<br/>(Record CONTROLLER_MAIN_PID)"]
    StartCfg --> StartOLC
    StartOLC --> CheckOLCOpts["Check OLC Credential Type"]
    CheckOmniCtrl -->|No| CheckOLCOpts
    CheckOLCOpts --> StartATS["Start ATS Server<br/>(/mtt/serve.sh in Background,<br/>Record COMMON_SERVICE_MAIN_PID)"]

    CheckCtrl -->|No| StartATS

    StartATS --> CheckWorker{"ENABLE_WORKER_FEATURES<br/>== true?"}

    CheckWorker -->|No| CheckPostRun{"Check Post-run Script"}

    CheckWorker -->|Yes| ConfigTF["Configure TradeFed Global Config<br/>& Virtual Device Pool"]
    ConfigTF --> ConfigADB{"MTT_USE_HOST_ADB<br/>unset?"}
    ConfigADB -->|Yes| StartADBLocal["Start ADB Server &<br/>Socat Forwarding to Container"]
    ConfigADB -->|No| StartADBHost["Socat Forwarding to Host ADB"]

    StartADBLocal --> CheckCVD{"MAX_LOCAL_VIRTUAL_DEVICES<br/>!= 0?"}
    StartADBHost --> CheckCVD

    CheckCVD -->|Yes| StartCVD["Start rsyslogd &<br/>Cuttlefish Common / ndppd"]
    CheckCVD -->|No| PrepWork["Prepare MTT_TEST_WORK_DIR<br/>& Calculate Heap"]
    StartCVD --> PrepWork

    PrepWork --> CheckOmniWorker{"IS_OMNILAB_BASED?"}

    CheckOmniWorker -->|No| RunTF["Start TradeFed in Background<br/>(Record WORKER_MAIN_PID)"]
    CheckOmniWorker -->|Yes| CheckCache{"Persistent Cache<br/>Enabled?"}

    CheckCache -->|Yes| StartCache["Start Cache Manager<br/>(cache_manager_server_deploy.jar)"]
    CheckCache -->|No| CheckLabCfg{"Connect Lab Server<br/>to Config Server?"}
    StartCache --> CheckLabCfg
    CheckLabCfg -->|Yes| CfgExt["Configure External Config Service<br/>(localhost:8081)"]
    CheckLabCfg -->|No| CfgLocal["Configure Local API Config<br/>(lab_server_api_config.textproto)"]
    CfgExt --> RunLabServer["Start OSS Lab Server in Background<br/>(Record WORKER_MAIN_PID)"]
    CfgLocal --> RunLabServer

    RunTF --> CheckPostRun
    RunLabServer --> CheckPostRun

    CheckPostRun -->|Exists| RunPost["Source init_post_run.sh"]
    CheckPostRun -->|None| WaitForServices
    RunPost --> WaitForServices

    WaitForServices["wait_for_services<br/>(Wait for controller, worker,<br/>or both to finish)"] --> End(["Exit Container"])
%% LINT.ThenChange(init.sh)
