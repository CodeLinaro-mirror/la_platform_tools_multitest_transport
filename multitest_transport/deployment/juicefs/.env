# LAN IP of the central file server host which should be accessed by all ATS workers via LAN.
# Required to provide a value.
JFS_VOLUME_IP=

# MySQL Settings
# Required to provide a value.
MYSQL_ROOT_PASSWORD=
# Required to provide a value.
MYSQL_USER=
# Required to provide a value.
MYSQL_PASSWORD=
MYSQL_DATABASE=juicefs
# Override if port 3306 conflicts on the host.
MYSQL_PORT=3306

# SeaweedFS Settings
# Host ports to bind to. Internal container ports are 9333, 8888, 8333.
# Override if 9333 conflicts on the host.
SEAWEEDFS_MASTER_PORT=9333
# Override if 8888 conflicts on the host.
SEAWEEDFS_FILER_PORT=8888
# Override if 8333 conflicts on the host.
SEAWEEDFS_S3_PORT=8333
BUCKET_NAME=jfs

# JuiceFS Settings
# JuiceFS filesystem's total capacity in GiB.
JFS_CAPACITY=800
JFS_VOLUME_NAME=mtt
# Mount path on the host machine.
HOST_MNT_PATH=/mnt/jfs

# Cache Manager Settings
CACHE_MANAGER_IMAGE=asia-docker.pkg.dev/omnilab-ats-repo/omnilab-ats-partner/cache-manager:latest
# Cache limit in GiB on the central file server. It should be less than JFS_CAPACITY.
CACHE_SIZE=600